{
  "expo": {
    "icon": "./src/assets/logo.png",
    "scheme": "barbers-bay",
    "userInterfaceStyle": "automatic",
    "orientation": "default",
    "web": {
      "bundler": "metro"
    },
    "name": "Barbers Bay",
    "slug": "barbers-bay",
    "plugins": ["expo-font", "expo-image"],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./src/assets/logo.png",
        "backgroundColor": "#FFFFFF"
      },
      "package": "com.yeasin.outside.barbersbay"
    }
  }
}
